# Server
NODE_ENV=production
PORT=5000
# Bind address (use 127.0.0.1 when running behind a reverse proxy on the same host)
HOST=0.0.0.0

# Database
MONGO_URI=mongodb://APP_USER:CHANGE_ME@mongodb:27017/ktmexpress?authSource=admin

# Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

# Initial super admin (created ONLY when the database has no users; never reset on restart)
ADMIN_EMAIL=admin@kdmexpress.com
ADMIN_PASSWORD=CHANGE_ME_min_12_chars

# CORS
CLIENT_URL=https://kdmexpress.com
FRONTEND_URL=https://kdmexpress.com

# Daily Automated Email Backup Settings (Gmail App Password)
REPORT_EMAIL=kdmexpress7@gmail.com
REPORT_EMAIL_TO=maharjandiplon@gmail.com
REPORT_EMAIL_APP_PASSWORD=your_16_char_google_app_password

# Email Settings (Optional SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=kdmexpress7@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
FROM_NAME=KDM Express Logistics
FROM_EMAIL=kdmexpress7@gmail.com

# Logging
LOG_LEVEL=info
